# Canonical public URL baked into shared results.
# Optional: when unset, the site derives its own URL from the page it's served from,
# which is already correct for both username.github.io/ramydle/ and a custom domain.
# Set it only to pin one canonical URL (e.g. so shares from the github.io address
# still point at your custom domain).
VITE_SITE_URL=https://ramydle.example.com
